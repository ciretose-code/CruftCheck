# macOS
.DS_Store

# Xcode — per-user state, never shared
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/

# The .xcodeproj is generated by xcodegen from project.yml but is committed so the
# repo opens in Xcode without extra tooling. Its per-user state is still ignored above.

# Machine-local signing, per developer/team — see Config/Signing.xcconfig
Config/Signing.local.xcconfig
